# RGB variant of Micro's Bubblegum theme (MIT licensed).
# Source: https://github.com/micro-editor/micro/blob/master/runtime/colorschemes/bubblegum.micro
# Explicit RGB avoids incorrect indexed background colors in Rex.
color-link default "#626262,#ffffff"
color-link comment "#949494,#ffffff"
color-link constant "#af5f00,#ffffff"
color-link constant.string "#af8700,#ffffff"
color-link constant.number "#af5f5f,#ffffff"
color-link identifier "#af5faf,#ffffff"
color-link statement "#0087d7,#ffffff"
color-link symbol "#0087d7,#ffffff"
color-link preproc "#008700,#ffffff"
color-link type "#5f5faf,#ffffff"
color-link special "#d75f5f,#ffffff"
color-link error "#ffffff, #d70000"
color-link underlined "underline #626262,#ffffff"
color-link todo "#949494,#ffffff"
color-link hlsearch "#ffffff,#af8700"
color-link statusline "#626262,#e4e4e4"
color-link tabbar "#626262,#e4e4e4"
color-link diff-added "#00af00"
color-link diff-modified "#ffaf00"
color-link diff-deleted "#d70000"
color-link gutter-error "#ff005f,#ffffff"
color-link gutter-warning "#af5fd7,#ffffff"
color-link line-number "#949494,#e4e4e4"
color-link cursor-line "#e4e4e4"
color-link color-column "#e4e4e4"
#No extended types (bool in C, &c.) and plain brackets
color-link type.extended "#626262,#ffffff"
color-link symbol.brackets "#626262,#ffffff"
color-link match-brace "#ffffff,#008700"
color-link tab-error "#ff8787"
color-link trailingws "#ff8787"
color-link indent-char "#bcbcbc"
